{
  "unstable": ["sloppy-imports"],
  "lint": {
    "include": ["src/"],
    "exclude": [
      ".next",
      "node_modules",
      "public",
      "dist"
    ],
    "rules": {
      "exclude": [
        "no-window",
        "no-window-prefix",
        "no-explicit-any",
        "require-await",
        "no-empty"
      ]
    }
  },
  "test": {
    "exclude": ["src/"]
  }
}
